-- Day 4, part b: count the pairs of ranges "lo-hi,lo-hi" that overlap at all.
begin
  param (/core; /representations; /system; builtin) : @(import("../../lib/builtin.zy")) that
  let make_aoc = @(import("../../lib/aoc.zy")) that
  let (/Thk; /Ret) = core that
  let (/String) = representations/string that
  let (/Int64) = representations/i64 that
  let (/OS) = system that
  let (/Bool; /bool; /option; /string; /char; /int64; /process; /read_line; /write_int; /char_at) =
    builtin |> make_aoc
  that

  -- Read the decimal number starting at `start`, returning it together with
  -- the position just after it.
  let ! chomp_int (text : String) (start : Int64) : Ret (Int64 * Int64) =
    do length <- ! string/length text;
    let fix loop (num : Int64) (cursor : Int64) : Ret (Int64 * Int64) =
      do at_end <- ! int64/eq cursor length;
      ! bool/if (Ret (Int64 * Int64)) at_end
        { ret (num, cursor) }
        {
          do c <- ! char_at text cursor;
          do code <- ! char/codepoint c;
          do after_slash <- ! int64/gt code 47;
          do before_colon <- ! int64/lt code 58;
          do is_digit <- ! bool/and after_slash before_colon;
          ! bool/if (Ret (Int64 * Int64)) is_digit
            {
              do digit <- ! int64/sub code 48;
              do num <- ! int64/mul num 10;
              do num <- ! int64/add num digit;
              do cursor <- ! int64/add cursor 1;
              ! loop num cursor
            }
            { ret (num, cursor) }
        }
    in
    ! loop 0 start
  that

  let ! parse_line (text : String) (k : Thk (Int64 -> Int64 -> Int64 -> Int64 -> OS)) : OS =
    do (lo0, cursor) <- ! chomp_int text 0;
    do cursor <- ! int64/add cursor 1;
    do (hi0, cursor) <- ! chomp_int text cursor;
    do cursor <- ! int64/add cursor 1;
    do (lo1, cursor) <- ! chomp_int text cursor;
    do cursor <- ! int64/add cursor 1;
    do (hi1, _) <- ! chomp_int text cursor;
    ! k lo0 hi0 lo1 hi1
  that

  let ! overlap (lo0 : Int64) (hi0 : Int64) (lo1 : Int64) (hi1 : Int64) : Ret Bool =
    do first_starts_in_time <- ! int64/le lo0 hi1;
    do second_starts_in_time <- ! int64/le lo1 hi0;
    ! bool/and first_starts_in_time second_starts_in_time
  that

  let fix loop (seen : Int64) : OS =
    ! read_line {
      fn line =>
        ! option/fold String OS line
          { ! write_int seen { ! process/exit 0 } }
          {
            fn text =>
              ! parse_line text {
                fn lo0 hi0 lo1 hi1 =>
                  do overlapping <- ! overlap lo0 hi0 lo1 hi1;
                  do seen <- ! bool/if (Ret Int64) overlapping { ! int64/add seen 1 } { ret seen };
                  ! loop seen
              }
          }
    }
  that

  ! loop 0
end

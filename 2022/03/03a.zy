-- Day 3, part a: the sum of the priorities of the item type that appears in
-- both halves of each rucksack.
begin
  param (/Ret; /String; /Int64; /Char; /OS; builtin) : @(import("../../lib/builtin.zy")) that
  let make_aoc = @(import("../../lib/aoc.zy")) that
  let (/bool; /option; /string; /char; /int64; /process; /read_line; /write_int; /char_eq; /char_at) =
    builtin |> make_aoc
  that

  -- The character occurring in both halves of `text`; '$' if there is none.
  let ! find_match (text : String) : Ret Char =
    do length <- ! string/length text;
    do half <- ! int64/div length 2;
    -- compare position i of the first half with position j of the second
    let fix loop (i : Int64) (j : Int64) : Ret Char =
      do i_done <- ! int64/eq i half;
      ! bool/if (Ret Char) i_done
        { ret '$' }
        {
          do j_done <- ! int64/eq j half;
          ! bool/if (Ret Char) j_done
            {
              do i <- ! int64/add i 1;
              ! loop i 0
            }
            {
              do ci <- ! char_at text i;
              do j' <- ! int64/add j half;
              do cj <- ! char_at text j';
              do same <- ! char_eq ci cj;
              ! bool/if (Ret Char) same
                { ret ci }
                {
                  do j <- ! int64/add j 1;
                  ! loop i j
                }
            }
        }
    in
    ! loop 0 0
  that

  -- a..z score 1..26 and A..Z score 27..52
  let ! priority (c : Char) : Ret Int64 =
    do code <- ! char/codepoint c;
    do uppercase <- ! int64/lt code 91;
    ! bool/if (Ret Int64) uppercase
      {
        do offset <- ! int64/sub code 65;
        ! int64/add offset 27
      }
      {
        do offset <- ! int64/sub code 97;
        ! int64/add offset 1
      }
  that

  let fix loop (sum : Int64) : OS =
    ! read_line {
      fn line =>
        ! option/fold String OS line
          { ! write_int sum { ! process/exit 0 } }
          {
            fn text =>
              do c <- ! find_match text;
              do p <- ! priority c;
              do sum <- ! int64/add sum p;
              ! loop sum
          }
    }
  that

  ! loop 0
end

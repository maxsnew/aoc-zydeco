-- Day 3, part b: rucksacks come in groups of three lines; sum the priorities
-- of the item type common to all three.
begin
  param (/core; /representations; /system; builtin) : @(import("../../lib/builtin.zy")) that
  let make_aoc = @(import("../../lib/aoc.zy")) that
  let (/Thk; /Ret) = core that
  let (/String) = representations/string that
  let (/Int64) = representations/i64 that
  let (/Char) = representations/char that
  let (/OS) = system that
  let (/Bool; /bool; /option; /string; /char; /int64; /process; /read_line; /write_int; /char_eq; /char_at) =
    builtin |> make_aoc
  that

  -- The sole character occurring in all three strings; '$' if there is none.
  let ! find_match (s0 : String) (s1 : String) (s2 : String) : Ret Char =
    do l0 <- ! string/length s0;
    do l1 <- ! string/length s1;
    do l2 <- ! string/length s2;
    -- does position k onwards of s2 contain c?
    let fix in_third (c : Char) (k : Int64) : Ret Bool =
      do k_done <- ! int64/eq k l2;
      ! bool/if (Ret Bool) k_done
        { ret bool/false }
        {
          do c2 <- ! char_at s2 k;
          do same <- ! char_eq c c2;
          ! bool/if (Ret Bool) same
            { ret bool/true }
            {
              do k <- ! int64/add k 1;
              ! in_third c k
            }
        }
    in
    -- compare position i of s0 with position j of s1
    let fix loop (i : Int64) (j : Int64) : Ret Char =
      do i_done <- ! int64/eq i l0;
      ! bool/if (Ret Char) i_done
        { ret '$' }
        {
          do j_done <- ! int64/eq j l1;
          ! bool/if (Ret Char) j_done
            {
              do i <- ! int64/add i 1;
              ! loop i 0
            }
            {
              do c0 <- ! char_at s0 i;
              do c1 <- ! char_at s1 j;
              do same <- ! char_eq c0 c1;
              do found <- ! bool/if (Ret Bool) same { ! in_third c0 0 } { ret bool/false };
              ! bool/if (Ret Char) found
                { ret c0 }
                {
                  do j <- ! int64/add j 1;
                  ! loop i j
                }
            }
        }
    in
    ! loop 0 0
  that

  -- a..z score 1..26 and A..Z score 27..52
  let ! priority (c : Char) : Ret Int64 =
    do code <- ! char/codepoint c;
    do uppercase <- ! int64/lt code 91;
    ! bool/if (Ret Int64) uppercase
      {
        do offset <- ! int64/sub code 65;
        ! int64/add offset 27
      }
      {
        do offset <- ! int64/sub code 97;
        ! int64/add offset 1
      }
  that

  -- Read a line that must be present.
  let ! expect_line (k : Thk (String -> OS)) : OS =
    ! read_line {
      fn line =>
        ! option/fold String OS line { ! process/panic "incomplete group of three" } k
    }
  that

  let fix loop (sum : Int64) : OS =
    ! read_line {
      fn line =>
        ! option/fold String OS line
          { ! write_int sum { ! process/exit 0 } }
          {
            fn s0 =>
              ! expect_line {
                fn s1 =>
                  ! expect_line {
                    fn s2 =>
                      do c <- ! find_match s0 s1 s2;
                      do p <- ! priority c;
                      do sum <- ! int64/add sum p;
                      ! loop sum
                  }
              }
          }
    }
  that

  ! loop 0
end

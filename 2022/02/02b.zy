-- Day 2, part b: total score when the second column names the required
-- outcome (X lose, Y draw, Z win) instead of our move.
begin
  param (/Thk; /Ret; /Unit; /String; /Int64; /Char; /OS; builtin) : @(import("../../lib/builtin.zy")) that
  let make_aoc = @(import("../../lib/aoc.zy")) that
  let (/bool; /option; /int64; /process; /read_line; /write_int; /char_eq; /char_at) =
    builtin |> make_aoc
  that

  def Move =
    data
    | +Rock : Unit
    | +Paper : Unit
    | +Scissors : Unit
    end
  that

  def Outcome =
    data
    | +Win : Unit
    | +Lose : Unit
    | +Draw : Unit
    end
  that

  def Game =
    data
    | +Game : Move * Outcome
    end
  that

  let ! parse_move (c : Char) : Ret Move =
    do is_rock <- ! char_eq c 'A';
    ! bool/if (Ret Move) is_rock
      { ret +Rock() }
      {
        do is_paper <- ! char_eq c 'B';
        ! bool/if (Ret Move) is_paper { ret +Paper() } { ret +Scissors() }
      }
  that

  let ! parse_outcome (c : Char) : Ret Outcome =
    do is_lose <- ! char_eq c 'X';
    ! bool/if (Ret Outcome) is_lose
      { ret +Lose() }
      {
        do is_draw <- ! char_eq c 'Y';
        ! bool/if (Ret Outcome) is_draw { ret +Draw() } { ret +Win() }
      }
  that

  let ! parse_game (text : String) : Ret Game =
    do l <- ! char_at text 0;
    do opponent <- ! parse_move l;
    do r <- ! char_at text 2;
    do outcome <- ! parse_outcome r;
    ret +Game(opponent, outcome)
  that

  let ! score_move (move : Move) : Ret Int64 =
    match move
    | +Rock() => ret 1
    | +Paper() => ret 2
    | +Scissors() => ret 3
    end
  that

  let ! score_outcome (outcome : Outcome) : Ret Int64 =
    match outcome
    | +Win() => ret 6
    | +Draw() => ret 3
    | +Lose() => ret 0
    end
  that

  -- The move that produces `outcome` against `opponent`.
  let ! calc_move (opponent : Move) (outcome : Outcome) : Ret Move =
    match opponent
    | +Rock() =>
      match outcome
      | +Lose() => ret +Scissors()
      | +Draw() => ret +Rock()
      | +Win() => ret +Paper()
      end
    | +Paper() =>
      match outcome
      | +Lose() => ret +Rock()
      | +Draw() => ret +Paper()
      | +Win() => ret +Scissors()
      end
    | +Scissors() =>
      match outcome
      | +Lose() => ret +Paper()
      | +Draw() => ret +Scissors()
      | +Win() => ret +Rock()
      end
    end
  that

  let ! score_game (game : Game) : Ret Int64 =
    match game
    | +Game(opponent, outcome) =>
      do player <- ! calc_move opponent outcome;
      do move_score <- ! score_move player;
      do outcome_score <- ! score_outcome outcome;
      ! int64/add move_score outcome_score
    end
  that

  let fix calc_score (score : Int64) (k : Thk (Int64 -> OS)) : OS =
    ! read_line {
      fn line =>
        ! option/fold String OS line
          { ! k score }
          {
            fn text =>
              do game <- ! parse_game text;
              do round <- ! score_game game;
              do score <- ! int64/add round score;
              ! calc_score score k
          }
    }
  that

  ! calc_score 0 { fn score => ! write_int score { ! process/exit 0 } }
end

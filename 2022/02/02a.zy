-- Day 2, part a: total score of a rock-paper-scissors tournament.
-- Each line holds the opponent's move (A, B, C) and our move (X, Y, Z).
begin
  param (/core; /representations; /system; builtin) : @(import("../../lib/builtin.zy")) that
  let make_aoc = @(import("../../lib/aoc.zy")) that
  let (/Thk; /Ret; /Unit) = core that
  let (/String) = representations/string that
  let (/Int64) = representations/i64 that
  let (/Char) = representations/char that
  let (/OS) = system that
  let (/bool; /option; /int64; /process; /read_line; /write_int; /char_eq; /char_at) =
    builtin |> make_aoc
  that

  def Move =
    data
    | +Rock : Unit
    | +Paper : Unit
    | +Scissors : Unit
    end
  that

  def Game =
    data
    | +Game : Move * Move
    end
  that

  -- Decode a move given the letters standing for rock and paper;
  -- any other letter is scissors.
  let ! parse_move (c : Char) (rock : Char) (paper : Char) : Ret Move =
    do is_rock <- ! char_eq c rock;
    ! bool/if (Ret Move) is_rock
      { ret +Rock() }
      {
        do is_paper <- ! char_eq c paper;
        ! bool/if (Ret Move) is_paper { ret +Paper() } { ret +Scissors() }
      }
  that

  let ! parse_game (text : String) : Ret Game =
    do l <- ! char_at text 0;
    do opponent <- ! parse_move l 'A' 'B';
    do r <- ! char_at text 2;
    do player <- ! parse_move r 'X' 'Y';
    ret +Game(opponent, player)
  that

  let ! score_move (move : Move) : Ret Int64 =
    match move
    | +Rock() => ret 1
    | +Paper() => ret 2
    | +Scissors() => ret 3
    end
  that

  let ! score_play (opponent : Move) (player : Move) : Ret Int64 =
    match opponent
    | +Rock() =>
      match player
      | +Rock() => ret 3     -- draw
      | +Paper() => ret 6    -- win
      | +Scissors() => ret 0 -- loss
      end
    | +Paper() =>
      match player
      | +Rock() => ret 0     -- loss
      | +Paper() => ret 3    -- draw
      | +Scissors() => ret 6 -- win
      end
    | +Scissors() =>
      match player
      | +Rock() => ret 6     -- win
      | +Paper() => ret 0    -- loss
      | +Scissors() => ret 3 -- draw
      end
    end
  that

  let ! score_game (game : Game) : Ret Int64 =
    match game
    | +Game(opponent, player) =>
      do move_score <- ! score_move player;
      do outcome_score <- ! score_play opponent player;
      ! int64/add move_score outcome_score
    end
  that

  let fix calc_score (score : Int64) (k : Thk (Int64 -> OS)) : OS =
    ! read_line {
      fn line =>
        ! option/fold String OS line
          { ! k score }
          {
            fn text =>
              do game <- ! parse_game text;
              do round <- ! score_game game;
              do score <- ! int64/add round score;
              ! calc_score score k
          }
    }
  that

  ! calc_score 0 { fn score => ! write_int score { ! process/exit 0 } }
end
